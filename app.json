{
  "expo": {
    "name": "Milk Man",
    "slug": "milkman",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chat",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyDummy_Key_Replace_With_Real_Key"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3E2723",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.muthudevv.milkman",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummy_Key_Replace_With_Real_Key"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 350,
          "resizeMode": "contain",
          "backgroundColor": "#3E2723",
          "dark": {
            "backgroundColor": "#3E2723"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc7248a4-9a4c-48fd-ad17-fc6cf9c66c33"
      }
    },
    "owner": "wentrite-technologies"
  }
}
